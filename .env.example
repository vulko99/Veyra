# -------------------------------------------------------------------------
# Veyra environment configuration (example).
# Copy to `.env` and fill in real values. NEVER commit the real .env.
# -------------------------------------------------------------------------

# Django
DJANGO_SECRET_KEY=change-me-generate-a-long-random-value
DJANGO_SETTINGS_MODULE=config.settings.development
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
LOG_LEVEL=INFO

# Database / cache
# Local Docker Compose defaults:
DATABASE_URL=postgres://veyra:veyra@db:5432/veyra
REDIS_URL=redis://redis:6379/0

# CORS / CSRF (frontend origin)
CORS_ALLOWED_ORIGINS=http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# PII hashing salt (rotate with care; changing it invalidates existing hashes)
HASH_SALT=change-me-to-a-random-salt

# Matching engine
MATCHING_TOP_N=3

# Document versions surfaced in consent capture
PRIVACY_POLICY_VERSION=2026-01-01
TERMS_VERSION=2026-01-01
# Version of the consent CHECKBOX WORDING (tracked separately from the policy
# documents). Bump whenever the consent copy in the funnel changes, so every
# stored consent proves exactly what text the user agreed to.
CONSENT_TEXT_VERSION=2026-09-01

# Data retention (days) used by the anonymization command
DATA_RETENTION_DAYS=365

# Loan-amount bounds (EUR) — single source of truth for backend validation.
# Keep in step with the frontend NEXT_PUBLIC_AMOUNT_* values.
AMOUNT_MIN_EUR=200
AMOUNT_MAX_EUR=15000
AMOUNT_STEP_EUR=100

# --- EGN (Bulgarian national id) — sensitive identity data ---
# Reversible encryption key for EGN at rest. NEVER hardcode; NEVER expose to the
# frontend. If unset, a key is derived from DJANGO_SECRET_KEY (a warning is
# logged). Generate a dedicated one, e.g.:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
EGN_ENCRYPTION_KEY=
# Intended EGN retention window (days). Deletion is NOT automatic until a
# retention policy is legally approved. 0 = unset.
EGN_RETENTION_DAYS=0

# Privacy Notice version presented to users and recorded against consent.
PRIVACY_NOTICE_VERSION=1.0

# --- Partner integrations (server-side only; never sent to the frontend) ---
# Iute partner API. Blank until a real integration is provisioned; no endpoints
# or credentials are invented in code.
IUTE_API_BASE_URL=
IUTE_API_KEY=
IUTE_CLIENT_ID=
IUTE_CLIENT_SECRET=

# Email (provider-agnostic; swap EMAIL_BACKEND for SMTP/Resend/SendGrid/SES)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=Veyra <noreply@veyra.example>
ADMIN_ALERT_EMAIL=alerts@veyra.example

# Error tracking (optional)
SENTRY_DSN=

# -------------------------------------------------------------------------
# Partner credentials — keep SEPARATE, one set per lender. Never commit.
# The webhook layer reads LENDER_<SLUG>_WEBHOOK_SECRET (slug upper-cased,
# dashes -> underscores). Example for slug "demo-lender-a":
# -------------------------------------------------------------------------
# LENDER_DEMO_LENDER_A_WEBHOOK_SECRET=
# LENDER_DEMO_LENDER_A_API_KEY=
# LENDER_DEMO_LENDER_A_SECRET=
