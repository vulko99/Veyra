# Frontend environment (copy to .env.local for local dev).

# --- API ---
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# --- Deployed origin -------------------------------------------------------
# Single source of truth for every absolute URL: canonical tags, OG URLs,
# sitemap.xml and robots.txt. Set this to the confirmed production domain.
# If unset, the build falls back to Netlify's own URL, so a preview or
# *.netlify.app deploy never claims to be the production domain.
# NEXT_PUBLIC_SITE_URL=https://veyra.bg

# --- Company identity (see TODO-LEGAL.md §1) -------------------------------
# Rendered in the footer, in the Google-Ads-mandated disclosures and in
# Organization JSON-LD. Unset values render as loud [[TODO:*]] placeholders and
# are omitted from structured data — never invent them.
# NEXT_PUBLIC_COMPANY_LEGAL_NAME=
# NEXT_PUBLIC_COMPANY_EIK=
# NEXT_PUBLIC_COMPANY_VAT=
# NEXT_PUBLIC_COMPANY_ADDRESS=
# NEXT_PUBLIC_COMPANY_PHONE=
# NEXT_PUBLIC_CONTACT_EMAIL=
# NEXT_PUBLIC_PRIVACY_EMAIL=

# --- Analytics -------------------------------------------------------------
# Nothing loads unless one of these is set AND the visitor grants analytics
# consent (see frontend/lib/consent.ts). Do not bypass the consent gate.
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
# NEXT_PUBLIC_PLAUSIBLE_DOMAIN=veyra.bg

# --- Search engine verification --------------------------------------------
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
# NEXT_PUBLIC_BING_SITE_VERIFICATION=
